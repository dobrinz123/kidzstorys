# RevenueCat Webhook Secret (from RevenueCat dashboard)
REVENUECAT_WEBHOOK_SECRET=your_webhook_secret_here

# Admin user emails (comma-separated)
ADMIN_ALLOWLIST_SEED_EMAILS=admin@example.com,editor@example.com

# Resend Email Configuration
# After verifying your domain in Resend dashboard, set this to your custom email
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Resend API Key
RESEND_API_KEY=re_xxxxxxxxxxxxx
