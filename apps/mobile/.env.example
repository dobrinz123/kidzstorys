# Convex Backend URL
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# RevenueCat API Keys (required for in-app purchases)
# Get these from your RevenueCat dashboard: https://app.revenuecat.com
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_WEB_KEY=rcb_xxxxxxxxxxxxx

# RevenueCat Entitlement ID (from RevenueCat dashboard)
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=PREMIUM

# EAS Project ID (from expo.dev dashboard)
# Run: eas project:init to generate
EAS_PROJECT_ID=

# Sentry Crash Reporting (optional)
# Get your DSN from sentry.io after creating a React Native project
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ENV=production
